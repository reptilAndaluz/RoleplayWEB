{
  "name": "rol-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo para rol.burgoslabs.es",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "db:up": "docker compose -f docker-compose.dev.yml up -d db",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:logs": "docker compose -f docker-compose.dev.yml logs -f db",
    "postinstall": "prisma generate --schema=./apps/api/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "argon2": "0.45.1",
    "dotenv": "16.4.5",
    "hono": "4.13.14",
    "prisma": "5.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "7.10.0",
    "@typescript-eslint/parser": "7.10.0",
    "eslint": "8.57.0",
    "prettier": "3.2.5",
    "rimraf": "5.0.7",
    "typescript": "5.4.5",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
