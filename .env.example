# Entorno
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Base de Datos (PostgreSQL)
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=public
POSTGRES_USER=rol_user
POSTGRES_PASSWORD=change_this_postgres_password_in_production
POSTGRES_DB=rol_db
DATABASE_URL=postgresql://rol_user:change_this_postgres_password_in_production@localhost:5432/rol_db?schema=public

# Seguridad y Sesiones
# Generar con: openssl rand -base64 32
SESSION_SECRET=change_this_session_secret_minimum_32_characters_long_base64

# Dominios y CORS / CSRF
# En desarrollo: http://localhost:5173
# En producción: https://rol.burgoslabs.es
ALLOWED_ORIGIN=http://localhost:5173

# Cloudflare Tunnel (Fase 7)
TUNNEL_TOKEN=your_cloudflare_tunnel_token_here
