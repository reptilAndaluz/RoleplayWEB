# =========================================================================
# ⚙️ CONFIGURACIÓN DEL ENTORNO DE DESARROLLO (.env)
# =========================================================================
# Copia este archivo, renómbralo a '.env' y completa tus datos.

# 💡 LLAVES CRIPTOGRÁFICAS (JSON Web Tokens):
# Genera una clave segura. Puedes usar un texto largo y aleatorio.
SECRET_KEY="cambia_esta_clave"

# 💡 BASE DE DATOS POSTGRESQL (Única fuente de verdad):
# Formato: postgresql://[usuario]:[password]@[host]:[puerto]/[base_de_datos]
# Ejemplo con Supabase u otro proveedor Cloud:
DATABASE_URL="postgresql://postgres:tu_password_seguro@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"

# 💡 CREDENCIALES DEL ADMINISTRADOR POR DEFECTO:
# Se utilizarán para crear el Primer Usuario Administrador al iniciar el servidor
# en caso de que la base de datos esté vacía.
ADMIN_USERNAME="admin_gremio"
ADMIN_PASSWORD="1234_cambiame_luego"
