# Entorno
NODE_ENV=development

# Base de Datos (Neon PostgreSQL + Prisma)
# Cadena CON connection pooler (usada en runtime serverless)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.eu-central-1.aws.neon.tech/rol_db?sslmode=require
# Cadena DIRECTA sin connection pooler (usada exclusivamente por prisma migrate)
DIRECT_URL=postgresql://user:password@ep-sample.eu-central-1.aws.neon.tech/rol_db?sslmode=require

# Seguridad y Sesiones
# Generar con: openssl rand -base64 32
SESSION_SECRET=change_this_session_secret_minimum_32_characters_long_base64

# Vercel Cron Secret (para proteger /api/cron/cleanup)
# Generar con: openssl rand -hex 32
CRON_SECRET=change_this_cron_secret_generated_random_value

# Dominios y CORS / CSRF
# En desarrollo: http://localhost:5173
# En producción: https://rol.burgoslabs.es
ALLOWED_ORIGIN=http://localhost:5173
