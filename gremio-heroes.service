# =========================================================================
# ARCHIVO DE SERVICIO SYSTEMD PARA EL CATÁLOGO D&D EN DEBIAN
# Ubicación en Debian: /etc/systemd/system/gremio-heroes.service
# Activación: 
#   sudo systemctl daemon-reload
#   sudo systemctl enable gremio-heroes.service
#   sudo systemctl start gremio-heroes.service
# =========================================================================

[Unit]
Description=Servidor Backend del Gremio de Héroes D&D (FastAPI)
After=network.target

[Service]
# Usuario de Debian que ejecutará la aplicación (reemplázalo si es otro)
User=reptil
WorkingDirectory=/home/reptil/Documentos/Catalogo_D-D

# Ruta al ejecutable de Uvicorn dentro del entorno virtual del proyecto
ExecStart=/home/reptil/Documentos/Catalogo_D-D/venv/bin/uvicorn server:app --host 127.0.0.1 --port 8000 --workers 4

# Reiniciar automáticamente el servicio si sufre un fallo o se cuelga
Restart=always
RestartSec=5

# Variables de entorno para la ejecución del servidor
Environment=PYTHONUNBUFFERED=1
# Puedes configurar variables de administración aquí o en un archivo externo .env
# Environment=ADMIN_USERNAME=admin
# Environment=ADMIN_PASSWORD=mi_contraseña_secreta

# Salida de registros redirigida a journalctl (sistema de logs nativo de Debian)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gremio-heroes

[Install]
WantedBy=multi-user.target
