:80 {
    encode gzip zstd

    # Proxy para endpoints de la API
    handle /api/* {
        reverse_proxy api:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    # Servir SPA React
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
